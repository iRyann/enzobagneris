{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Articles du journal de terrain"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "category": {
      "type": "enumeration",
      "enum": ["Pédagogie", "Science", "Chantier Nature", "Montagne"],
      "required": true
    },
    "tags": {
      "type": "json"
    },
    "publishedDate": {
      "type": "string"
    },
    "coverImage": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-asset"
    },
    "gallery": {
      "type": "component",
      "repeatable": true,
      "component": "shared.image-asset"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
